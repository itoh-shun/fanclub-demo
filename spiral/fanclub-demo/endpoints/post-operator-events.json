{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "body",
      "maxBytes": 256,
      "maxLength": 256,
      "name": "title",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "maxBytes": 2048,
      "maxLength": 2048,
      "name": "body",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "maxBytes": 256,
      "maxLength": 256,
      "name": "venue",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "max": 2,
      "min": 1,
      "name": "min_tier",
      "required": true,
      "type": "int"
    },
    {
      "enum": [
        "1",
        "2",
        "3"
      ],
      "in": "body",
      "name": "event_state",
      "required": true,
      "type": "enum"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "opens_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "closes_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "starts_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "results_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "maxBytes": 64,
      "maxLength": 64,
      "name": "seed_key",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    }
  ],
  "key": "post-operator-events",
  "method": "POST",
  "name": "YOIN POST /operator/events",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "created._id"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "1"
        }
      }
    ],
    "kind": "object",
    "status": 201
  },
  "path": "/operator/events",
  "roles": [
    "operator"
  ],
  "scope": "club.operate",
  "security": {
    "mfaMaxAgeSec": 300,
    "requireMfa": true
  },
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-operator'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'operator' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "member_active",
      "kind": "check"
    },
    {
      "error": {
        "message": "受付・結果公開・開催日時の順序を確認してください。",
        "status": 400
      },
      "expr": "ADD_HOURS(input.opens_at, 0) < ADD_HOURS(input.closes_at, 0) AND ADD_HOURS(input.closes_at, 0) <= ADD_HOURS(input.results_at, 0) AND ADD_HOURS(input.results_at, 0) <= ADD_HOURS(input.starts_at, 0)",
      "id": "date_order",
      "kind": "check"
    },
    {
      "db": "fc_events",
      "id": "created",
      "kind": "insert",
      "values": {
        "body": {
          "expr": "input.body"
        },
        "closes_at": {
          "expr": "ADD_HOURS(input.closes_at, 0)"
        },
        "event_state": {
          "expr": "input.event_state"
        },
        "min_tier": {
          "expr": "input.min_tier"
        },
        "opens_at": {
          "expr": "ADD_HOURS(input.opens_at, 0)"
        },
        "results_at": {
          "expr": "ADD_HOURS(input.results_at, 0)"
        },
        "seed_key": {
          "expr": "input.seed_key"
        },
        "starts_at": {
          "expr": "ADD_HOURS(input.starts_at, 0)"
        },
        "title": {
          "expr": "input.title"
        },
        "venue": {
          "expr": "input.venue"
        },
        "version": 1
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
