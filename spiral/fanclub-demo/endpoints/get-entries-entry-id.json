{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "path",
      "max": 2147483647,
      "min": 1,
      "name": "entry_id",
      "required": true,
      "type": "int"
    }
  ],
  "key": "get-entries-entry-id",
  "method": "GET",
  "name": "YOIN GET /entries/{entry_id}",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "entry._id"
        }
      },
      {
        "name": "event_id",
        "value": {
          "expr": "entry.event_id"
        }
      },
      {
        "name": "app_state",
        "value": {
          "expr": "IF((entry.app_state = '3' OR entry.app_state = '4') AND NOW() < ADD_HOURS(event.results_at, 0), '1', entry.app_state)"
        }
      },
      {
        "name": "applied_at",
        "value": {
          "expr": "entry.applied_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "entry.version"
        }
      },
      {
        "name": "event_title",
        "value": {
          "expr": "event.title"
        }
      },
      {
        "name": "starts_at",
        "value": {
          "expr": "event.starts_at"
        }
      },
      {
        "name": "venue",
        "value": {
          "expr": "event.venue"
        }
      },
      {
        "name": "can_withdraw",
        "value": {
          "expr": "entry.app_state = '1' AND NOW() < ADD_HOURS(event.closes_at, 0)"
        }
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/entries/{entry_id}",
  "scope": "club.read",
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-web'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'member' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "db": "fc_entries",
      "forUpdate": false,
      "id": "entry",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "all": [
          {
            "field": "member_id",
            "op": "eq",
            "value": {
              "expr": "session.sub"
            }
          },
          {
            "field": "_id",
            "op": "eq",
            "value": {
              "expr": "input.entry_id"
            }
          }
        ]
      }
    },
    {
      "db": "fc_events",
      "forUpdate": false,
      "id": "event",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "entry.event_id"
        }
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
