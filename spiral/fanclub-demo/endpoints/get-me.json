{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [],
  "key": "get-me",
  "method": "GET",
  "name": "YOIN GET /me",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "me._id"
        }
      },
      {
        "name": "display_name",
        "value": {
          "expr": "me.display_name"
        }
      },
      {
        "name": "tier_level",
        "value": {
          "expr": "me.tier_level"
        }
      },
      {
        "name": "member_state",
        "value": {
          "expr": "me.member_state"
        }
      },
      {
        "name": "joined_at",
        "value": {
          "expr": "me.joined_at"
        }
      },
      {
        "name": "expires_at",
        "value": {
          "expr": "me.expires_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "me.version"
        }
      },
      {
        "name": "member_number",
        "value": {
          "expr": "CONCAT('FC-', me._id)"
        }
      },
      {
        "name": "active",
        "value": {
          "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()"
        }
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/me",
  "scope": "club.read",
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-web'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'member' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
