{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "query",
      "min": 1,
      "name": "event_id",
      "type": "int"
    }
  ],
  "key": "get-entries",
  "method": "GET",
  "name": "YOIN GET /entries",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "row._id"
        }
      },
      {
        "name": "event_id",
        "value": {
          "expr": "row.event_id"
        }
      },
      {
        "name": "app_state",
        "value": {
          "expr": "IF((row.app_state = '3' OR row.app_state = '4') AND NOT ARRAY_HAS(result_ids, row.event_id), '1', row.app_state)"
        }
      },
      {
        "name": "applied_at",
        "value": {
          "expr": "row.applied_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "row.version"
        }
      }
    ],
    "from": "rows",
    "kind": "list",
    "status": 200
  },
  "path": "/entries",
  "scope": "club.read",
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-web'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'member' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "db": "fc_events",
      "forUpdate": false,
      "id": "result_events",
      "kind": "query",
      "limit": 20,
      "single": false,
      "where": {
        "field": "results_at",
        "op": "lte",
        "value": {
          "expr": "NOW()"
        }
      }
    },
    {
      "id": "result_ids",
      "kind": "set",
      "value": {
        "expr": "result_events._id"
      }
    },
    {
      "db": "fc_entries",
      "forUpdate": false,
      "id": "rows",
      "kind": "query",
      "limit": 20,
      "orderBy": [
        {
          "dir": "desc",
          "field": "applied_at"
        },
        {
          "dir": "desc",
          "field": "_id"
        }
      ],
      "single": false,
      "where": {
        "all": [
          {
            "field": "member_id",
            "op": "eq",
            "value": {
              "expr": "session.sub"
            }
          },
          {
            "field": "event_id",
            "op": "eq",
            "value": {
              "expr": "input.event_id"
            },
            "whenInput": "event_id"
          }
        ]
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
