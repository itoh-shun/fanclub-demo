{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "body",
      "max": 2147483646,
      "min": 1,
      "name": "entry_id",
      "required": true,
      "type": "int"
    }
  ],
  "key": "post-operator-notify-result",
  "method": "POST",
  "name": "YOIN POST /operator/notify/result",
  "output": {
    "fields": [
      {
        "name": "accepted",
        "value": true
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/operator/notify/result",
  "roles": [
    "operator"
  ],
  "scope": "club.operate",
  "security": {
    "mfaMaxAgeSec": 300,
    "requireMfa": true
  },
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-operator'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'operator' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "member_active",
      "kind": "check"
    },
    {
      "db": "fc_entries",
      "forUpdate": false,
      "id": "entry",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "input.entry_id"
        }
      }
    },
    {
      "db": "fc_events",
      "forUpdate": false,
      "id": "event",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "entry.event_id"
        }
      }
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "recipient",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "entry.member_id"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "(entry.app_state = '3' OR entry.app_state = '4') AND event.event_state != '3' AND NOW() >= ADD_HOURS(event.results_at, 0) AND recipient.role_code = 'member' AND recipient.member_state != '3'",
      "id": "notify_allowed",
      "kind": "check"
    },
    {
      "body": "応募結果を更新しました",
      "clientId": "fanclub-web",
      "id": "queued",
      "kind": "push",
      "member": {
        "expr": "recipient._id"
      },
      "title": "YOIN CLUB",
      "url": "/entries"
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
