{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "body",
      "maxBytes": 64,
      "maxLength": 64,
      "name": "display_name",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "max": 2147483646,
      "min": 1,
      "name": "version",
      "required": true,
      "type": "int"
    }
  ],
  "key": "post-me-profile",
  "method": "POST",
  "name": "YOIN POST /me/profile",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "session.sub"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "input.version + 1"
        }
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/me/profile",
  "scope": "club.write",
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-web'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'member' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "error": {
        "message": "内容が更新されています。最新の情報を確認してください。",
        "status": 409
      },
      "expect": "one",
      "id": "updated",
      "kind": "update",
      "set": {
        "display_name": {
          "expr": "TRIM(input.display_name)"
        },
        "version": {
          "expr": "input.version + 1"
        }
      },
      "where": {
        "all": [
          {
            "field": "_id",
            "op": "eq",
            "value": {
              "expr": "session.sub"
            }
          },
          {
            "field": "version",
            "op": "eq",
            "value": {
              "expr": "input.version"
            }
          }
        ]
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
