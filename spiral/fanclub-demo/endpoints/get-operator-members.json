{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "default": 0,
      "in": "query",
      "max": 100,
      "min": 0,
      "name": "offset",
      "type": "int"
    },
    {
      "default": 20,
      "in": "query",
      "max": 20,
      "min": 1,
      "name": "limit",
      "type": "int"
    }
  ],
  "key": "get-operator-members",
  "method": "GET",
  "name": "YOIN GET /operator/members",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "row._id"
        }
      },
      {
        "name": "display_name",
        "value": {
          "expr": "row.display_name"
        }
      },
      {
        "name": "tier_level",
        "value": {
          "expr": "row.tier_level"
        }
      },
      {
        "name": "member_state",
        "value": {
          "expr": "row.member_state"
        }
      },
      {
        "name": "joined_at",
        "value": {
          "expr": "row.joined_at"
        }
      },
      {
        "name": "expires_at",
        "value": {
          "expr": "row.expires_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "row.version"
        }
      },
      {
        "name": "member_number",
        "value": {
          "expr": "CONCAT('FC-', row._id)"
        }
      },
      {
        "name": "active",
        "value": {
          "expr": "row.member_state = '2' AND ADD_HOURS(row.expires_at, 0) > NOW()"
        }
      },
      {
        "name": "role_code",
        "value": {
          "expr": "row.role_code"
        }
      }
    ],
    "from": "rows",
    "kind": "list",
    "status": 200
  },
  "path": "/operator/members",
  "roles": [
    "operator"
  ],
  "scope": "club.operate",
  "security": {
    "mfaMaxAgeSec": 300,
    "requireMfa": true
  },
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-operator'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'operator' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "member_active",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "rows",
      "kind": "query",
      "limit": {
        "expr": "input.limit"
      },
      "offset": {
        "expr": "input.offset"
      },
      "orderBy": [
        {
          "dir": "asc",
          "field": "_id"
        }
      ],
      "single": false,
      "where": {
        "field": "role_code",
        "op": "eq",
        "value": "member"
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
