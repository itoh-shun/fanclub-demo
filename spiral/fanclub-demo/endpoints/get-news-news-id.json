{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "path",
      "max": 2147483647,
      "min": 1,
      "name": "news_id",
      "required": true,
      "type": "int"
    }
  ],
  "key": "get-news-news-id",
  "method": "GET",
  "name": "YOIN GET /news/{news_id}",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "article._id"
        }
      },
      {
        "name": "title",
        "value": {
          "expr": "article.title"
        }
      },
      {
        "name": "teaser",
        "value": {
          "expr": "article.teaser"
        }
      },
      {
        "name": "cover_key",
        "value": {
          "expr": "article.cover_key"
        }
      },
      {
        "name": "min_tier",
        "value": {
          "expr": "article.min_tier"
        }
      },
      {
        "name": "published_at",
        "value": {
          "expr": "article.published_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "article.version"
        }
      },
      {
        "name": "body",
        "value": {
          "expr": "article.body"
        }
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/news/{news_id}",
  "scope": "club.read",
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-web'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'member' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "require_active",
      "kind": "check"
    },
    {
      "db": "fc_news",
      "forUpdate": false,
      "id": "article",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "all": [
          {
            "field": "pub_state",
            "op": "eq",
            "value": "2"
          },
          {
            "field": "published_at",
            "op": "lte",
            "value": {
              "expr": "NOW()"
            }
          },
          {
            "field": "min_tier",
            "op": "lte",
            "value": {
              "expr": "me.tier_level"
            }
          },
          {
            "field": "_id",
            "op": "eq",
            "value": {
              "expr": "input.news_id"
            }
          }
        ]
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
