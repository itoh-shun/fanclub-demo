{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "in": "body",
      "maxBytes": 256,
      "maxLength": 256,
      "name": "title",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "maxBytes": 2048,
      "maxLength": 2048,
      "name": "body",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "maxBytes": 256,
      "maxLength": 256,
      "name": "venue",
      "pattern": {
        "source": "\\S"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "body",
      "max": 2,
      "min": 1,
      "name": "min_tier",
      "required": true,
      "type": "int"
    },
    {
      "enum": [
        "1",
        "2",
        "3"
      ],
      "in": "body",
      "name": "event_state",
      "required": true,
      "type": "enum"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "opens_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "closes_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "starts_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "format": "date-time",
      "in": "body",
      "maxLength": 40,
      "name": "results_at",
      "pattern": {
        "source": ".+(Z|[+-][0-9]{2}:[0-9]{2})$"
      },
      "required": true,
      "type": "string"
    },
    {
      "in": "path",
      "max": 2147483647,
      "min": 1,
      "name": "event_id",
      "required": true,
      "type": "int"
    },
    {
      "in": "body",
      "max": 2147483646,
      "min": 1,
      "name": "version",
      "required": true,
      "type": "int"
    }
  ],
  "key": "post-operator-events-event-id",
  "method": "POST",
  "name": "YOIN POST /operator/events/{event_id}",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "input.event_id"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "input.version + 1"
        }
      }
    ],
    "kind": "object",
    "status": 200
  },
  "path": "/operator/events/{event_id}",
  "roles": [
    "operator"
  ],
  "scope": "club.operate",
  "security": {
    "mfaMaxAgeSec": 300,
    "requireMfa": true
  },
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-operator'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'operator' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "member_active",
      "kind": "check"
    },
    {
      "db": "fc_events",
      "forUpdate": false,
      "id": "target",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "input.event_id"
        }
      }
    },
    {
      "error": {
        "message": "受付・結果公開・開催日時の順序を確認してください。",
        "status": 400
      },
      "expr": "ADD_HOURS(input.opens_at, 0) < ADD_HOURS(input.closes_at, 0) AND ADD_HOURS(input.closes_at, 0) <= ADD_HOURS(input.results_at, 0) AND ADD_HOURS(input.results_at, 0) <= ADD_HOURS(input.starts_at, 0)",
      "id": "date_order",
      "kind": "check"
    },
    {
      "error": {
        "message": "応募開始後は閉鎖・中止のみ変更できます。",
        "status": 409
      },
      "expr": "NOW() < ADD_HOURS(target.opens_at, 0) OR (input.title = target.title AND input.body = target.body AND input.venue = target.venue AND input.min_tier = target.min_tier AND ADD_HOURS(input.opens_at, 0) = ADD_HOURS(target.opens_at, 0) AND ADD_HOURS(input.closes_at, 0) = ADD_HOURS(target.closes_at, 0) AND ADD_HOURS(input.starts_at, 0) = ADD_HOURS(target.starts_at, 0) AND ADD_HOURS(input.results_at, 0) = ADD_HOURS(target.results_at, 0) AND (input.event_state = '2' OR input.event_state = '3'))",
      "id": "frozen_conditions",
      "kind": "check"
    },
    {
      "db": "fc_events",
      "error": {
        "message": "内容が更新されています。最新の情報を確認してください。",
        "status": 409
      },
      "expect": "one",
      "id": "updated",
      "kind": "update",
      "set": {
        "body": {
          "expr": "input.body"
        },
        "closes_at": {
          "expr": "ADD_HOURS(input.closes_at, 0)"
        },
        "event_state": {
          "expr": "input.event_state"
        },
        "min_tier": {
          "expr": "input.min_tier"
        },
        "opens_at": {
          "expr": "ADD_HOURS(input.opens_at, 0)"
        },
        "results_at": {
          "expr": "ADD_HOURS(input.results_at, 0)"
        },
        "starts_at": {
          "expr": "ADD_HOURS(input.starts_at, 0)"
        },
        "title": {
          "expr": "input.title"
        },
        "venue": {
          "expr": "input.venue"
        },
        "version": {
          "expr": "input.version + 1"
        }
      },
      "where": {
        "all": [
          {
            "field": "_id",
            "op": "eq",
            "value": {
              "expr": "input.event_id"
            }
          },
          {
            "field": "version",
            "op": "eq",
            "value": {
              "expr": "input.version"
            }
          }
        ]
      }
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
