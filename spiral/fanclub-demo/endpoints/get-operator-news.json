{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/endpoint.schema.json",
  "auth": "session",
  "input": [
    {
      "default": 0,
      "in": "query",
      "max": 100,
      "min": 0,
      "name": "offset",
      "type": "int"
    },
    {
      "default": 20,
      "in": "query",
      "max": 20,
      "min": 1,
      "name": "limit",
      "type": "int"
    }
  ],
  "key": "get-operator-news",
  "method": "GET",
  "name": "YOIN GET /operator/news",
  "output": {
    "fields": [
      {
        "name": "id",
        "value": {
          "expr": "row._id"
        }
      },
      {
        "name": "title",
        "value": {
          "expr": "row.title"
        }
      },
      {
        "name": "teaser",
        "value": {
          "expr": "row.teaser"
        }
      },
      {
        "name": "cover_key",
        "value": {
          "expr": "row.cover_key"
        }
      },
      {
        "name": "min_tier",
        "value": {
          "expr": "row.min_tier"
        }
      },
      {
        "name": "published_at",
        "value": {
          "expr": "row.published_at"
        }
      },
      {
        "name": "version",
        "value": {
          "expr": "row.version"
        }
      },
      {
        "name": "seed_key",
        "value": {
          "expr": "row.seed_key"
        }
      },
      {
        "name": "body",
        "value": {
          "expr": "row.body"
        }
      },
      {
        "name": "pub_state",
        "value": {
          "expr": "row.pub_state"
        }
      }
    ],
    "from": "rows",
    "kind": "list",
    "status": 200
  },
  "path": "/operator/news",
  "roles": [
    "operator"
  ],
  "scope": "club.operate",
  "security": {
    "mfaMaxAgeSec": 300,
    "requireMfa": true
  },
  "steps": [
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "session.clientId = 'fanclub-operator'",
      "id": "client_allowed",
      "kind": "check"
    },
    {
      "db": "fc_members",
      "forUpdate": false,
      "id": "me",
      "kind": "query",
      "notFound": {
        "message": "情報が見つかりません。",
        "status": 404
      },
      "single": true,
      "where": {
        "field": "_id",
        "op": "eq",
        "value": {
          "expr": "session.sub"
        }
      }
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.role_code = 'operator' AND me.member_state != '3'",
      "id": "member_allowed",
      "kind": "check"
    },
    {
      "error": {
        "message": "この操作は利用できません。",
        "status": 403
      },
      "expr": "me.member_state = '2' AND ADD_HOURS(me.expires_at, 0) > NOW()",
      "id": "member_active",
      "kind": "check"
    },
    {
      "db": "fc_news",
      "forUpdate": false,
      "id": "rows",
      "kind": "query",
      "limit": {
        "expr": "input.limit"
      },
      "offset": {
        "expr": "input.offset"
      },
      "orderBy": [
        {
          "dir": "asc",
          "field": "_id"
        }
      ],
      "single": false
    }
  ],
  "strictInput": true,
  "validationVersion": 2
}
