{
  "$schema": "https://schemas.sito-dev.com/project-config/v2/auth.schema.json",
  "db": "fc_members",
  "loginField": "login_email",
  "passwordPolicy": {
    "maxBytes": 72,
    "minLength": 12
  },
  "registration": {
    "allowedClientIds": [
      "fanclub-web"
    ],
    "defaults": {
      "member_state": "1",
      "tier_level": 1,
      "version": 1
    },
    "enabled": false,
    "fields": [
      {
        "dbField": "login_email",
        "inputName": "login_email",
        "required": true
      },
      {
        "dbField": "display_name",
        "inputName": "display_name",
        "required": true
      }
    ],
    "passwordField": "passwd",
    "spiralOperationField": "signup_op"
  },
  "roleField": "role_code",
  "sessionValues": {}
}
